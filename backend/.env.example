# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jansetu

# Authentication and integration secrets (generate unique values; never commit .env)
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_SECRET=replace-with-a-long-random-admin-secret
DASHBOARD_API_KEY=replace-with-a-long-random-dashboard-key
GOOGLE_CLIENT_ID=
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-whatsapp-verification-token
WHATSAPP_APP_SECRET=
NVIDIA_API_KEY=
NVIDIA_ASR_API_KEY=
NVIDIA_TTS_API_KEY=
BREETH_API_KEY=
VIASOCKET_WEBHOOK_URL=

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Application Settings
ENVIRONMENT=development
DEBUG=false
